<%- include('partials/header') %>

  <% if (service && service.id!='digital-marketing-services' ) { %>
    <!-- Hero Section -->
    <section class="hero-section py-6">
      <div class="bg-holder overlay" style="
    background-image: url(/assets/img/background-2.webp);
    background-position: center bottom;
    filter: opacity(0.4);
  "></div>
      <div class="container">
        <div class="row" data-inertia='{"weight":1.5}'>
          <div class="col-lg-8 text-white" data-zanim-timeline="{}" data-zanim-trigger="scroll">
            <div class="overflow-hidden">
              <% if (service && service.title) { %>
                <h1 class="fs-4 fs-md-5 mb-3 lh-1" data-zanim-xs='{"delay":0}'>
                  <%= service.title %>
                </h1>
                <% } %>
                  <div class="nav" aria-label="breadcrumb" role="navigation" data-zanim-xs='{"delay":0.2}'>
                    <ol class="breadcrumb fs-1 ps-0 fw-bold">
                      <li class="breadcrumb-item"><a class="text-primary" href="/">Home</a></li>
                      <li class="breadcrumb-item"><a class="text-primary" href="/services">Services</a></li>
                      <% if (service && service.title) { %>
                        <li class="breadcrumb-item text-primary active" aria-current="page">
                          <%= service.title %>
                        </li>
                        <% } %>
                    </ol>
                  </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="bg-100 py-6">
      <div class="container">
        <div class="row">
          <!-- Heading Description -->
          <% if (service && service.description) { %>
            <div class="col-12">
              <div class="card mb-4">
                <div class="card-body p-4 p-lg-5">
                  <p class="lead fw-semi-bold mb-4" data-zanim-xs='{"delay":0.1}'>
                    <%= service.description %>
                  </p>
                </div>
              </div>
            </div>
            <% } %>
              <!-- Each content row -->
              <% if (service && service.content && Array.isArray(service.content)) { %>
                <% service.content.forEach((section, index)=> { %>
                  <div class="row">
                    <!-- Content Column -->
                    <div class="col-lg-8">
                      <div class="card mb-4"
                        id="<%= section.id ? section.id : section.heading.toLowerCase().replace(/\s+/g, '-') %>">
                        <div class="card-body p-4 p-lg-5">
                          <% if (section.heading) { %>
                            <h3 class="mb-4">
                              <%= section.heading %>
                            </h3>
                            <% } %>
                              <% if (section.description) { %>
                                <p class="lead mb-4">
                                  <%= section.description %>
                                </p>
                                <% } %>

                                  <% if (section.offerings && Array.isArray(section.offerings) &&
                                    section.offerings.length>
                                    0) {
                                    %>
                                    <h5 class="mb-3">Offerings:</h5>
                                    <ul class="list-unstyled mb-4">
                                      <% section.offerings.forEach(offering=> { %>
                                        <li class="mb-2">• <%= offering %>
                                        </li>
                                        <% }) %>
                                    </ul>
                                    <% } %>

                                      <% if (section.valueAdd) { %>
                                        <div class="value-add bg-200 p-4 rounded-3 mb-4">
                                          <h5 class="mb-3">HADITA Value Add:</h5>
                                          <p class="mb-0">
                                            <%= section.valueAdd %>
                                          </p>
                                        </div>
                                        <% } %>

                        </div>
                      </div>
                    </div>
                    <!-- Sidebar Column -->
                    <div class="col-lg-4">

                      <!-- Intra Links -->
                      <div class="card mb-4">
                        <div class="card-body">
                          <h5 class="mb-3">Related Services</h5>
                          <ul class="nav flex-column">
                            <% section.intraLinks.forEach(link=> { %>
                              <% if (link && link.title && link.url) { %>
                                <li class="nav-item">
                                  <a class="nav-link ps-0" href="<%= link.url %>">
                                    <%= link.title %>
                                  </a>
                                </li>
                                <% } %>
                                  <% }) %>
                          </ul>
                        </div>
                      </div>
                      <!-- Section CTA -->
                      <% if (section.cta) { %>
                        <div class="cta-section bg-primary text-white p-4 rounded-3 mb-4">
                          <% if (section.cta.title) { %>
                            <h5 class="text-center text-white mb-3">
                              <%= section.cta.title %>
                            </h5>
                            <% } %>
                              <form class="consultation-form cta-form">
                                <input type="hidden" name="source" value="<%= service.id %>">
                                <div class="row g-3">
                                  <div class="col-md-6">
                                    <input type="text" class="form-control" name="name"
                                      placeholder="<%= section.cta.form && section.cta.form.name ? section.cta.form.name : 'Name' %>"
                                      required>
                                  </div>
                                  <div class="col-md-6">
                                    <input type="tel" class="form-control" name="mobile"
                                      placeholder="<%= section.cta.form && section.cta.form.mobile ? section.cta.form.mobile : 'Mobile Number' %>"
                                      required>
                                  </div>
                                  <div class="col-12">
                                    <button type="submit" class="btn btn-warning w-100">
                                      <%= section.cta.buttonText ? section.cta.buttonText : 'Request Call Back' %>
                                    </button>
                                  </div>
                                </div>
                              </form>
                        </div>
                        <% } %>
                    </div>
                  </div>
                  <% }) %>
                    <% } %>
        </div>
      </div>
    </section>

    <!-- Footer CTA Section -->
    <section class="bg-primary text-white py-6">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-8 text-center text-lg-start mb-4 mb-lg-0">
            <% if (service && service.footer && service.footer.description) { %>
              <h4 class="mb-3 lh-base text-white">
                <%= service.footer.description %>
              </h4>
              <% } %>
          </div>
          <div class="col-lg-4">
            <div class="card bg-white text-dark p-4">
              <% if (service && service.footer && service.footer.cta && service.footer.cta.title) { %>
                <h4 class="text-center mb-3">
                  <%= service.footer.cta.title %>
                </h4>
                <% } %>
                  <form class="cta-form">
                    <input type="hidden" name="source" value="<%= service.id %>">
                    <div class="mb-3">
                      <input type="text" name="name" class="form-control"
                        placeholder="<%= service && service.footer && service.footer.cta && service.footer.cta.form && service.footer.cta.form.name ? service.footer.cta.form.name : 'Name' %>"
                        required>
                    </div>
                    <div class="mb-3">
                      <input type="tel" name="mobile" class="form-control"
                        placeholder="<%= service && service.footer && service.footer.cta && service.footer.cta.form && service.footer.cta.form.mobile ? service.footer.cta.form.mobile : 'Mobile Number' %>"
                        required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                      <%= service && service.footer && service.footer.cta && service.footer.cta.form &&
                        service.footer.cta.form.buttonText ? service.footer.cta.form.buttonText : 'Submit' %>
                    </button>
                  </form>
            </div>
          </div>
        </div>
      </div>
    </section>
